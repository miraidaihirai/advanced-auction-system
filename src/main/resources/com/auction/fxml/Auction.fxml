<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="20.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.UI.AuctionController">

    <children>
        <Label text="Auction Room"/>

        <HBox alignment="CENTER" spacing="10.0">
            <Label text="Auction ID:"/>

            <TextField fx:id="auctionIdField"
                       promptText="Enter auction ID"/>

            <Button fx:id="joinButton"
                    text="Join Auction"
                    onAction="#handleJoinAuction"/>
        </HBox>

        <Label fx:id="auctionInfoLabel"
               text="Join an auction to view its information."/>

        <HBox alignment="CENTER" spacing="10.0">
            <TextField fx:id="bidAmountField"
                       promptText="Enter your bid amount"/>

            <Button fx:id="placeBidButton"
                    text="Place Bid"
                    onAction="#handlePlaceBid"/>
        </HBox>

        <Label fx:id="statusLabel"
               text="Ready"/>

        <Button fx:id="backButton"
                text="Back to Home"
                onAction="#handleBackToHome"/>
    </children>

    <padding>
        <Insets top="30.0"
                right="30.0"
                bottom="30.0"
                left="30.0"/>
    </padding>

</VBox>


