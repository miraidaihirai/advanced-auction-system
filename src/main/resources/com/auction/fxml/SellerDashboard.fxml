                    <VBox spacing="5">
                      <Label text="Tên sản phẩm đấu giá *" styleClass="field-label"/>
                      <TextField fx:id="txtItemName" promptText="VD: Đồng Hồ Rolex Datejust 41mm Vàng Hồng..." styleClass="bidx-input"/>
