        </top>

        <center>
          <StackPane minWidth="0" minHeight="0">
            <!-- TAB 1: OVERVIEW & SELLER WALLET -->
            <ScrollPane fx:id="tabOverview" fitToWidth="true" hbarPolicy="NEVER" minWidth="0" styleClass="bidx-scroll">
              <VBox spacing="18" minWidth="0" style="-fx-padding: 20 22 26 22;">
