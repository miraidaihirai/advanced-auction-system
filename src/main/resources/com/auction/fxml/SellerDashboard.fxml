                  <VBox spacing="8" minWidth="240" HBox.hgrow="ALWAYS" styleClass="kpi-card-highlight-emerald">
                    <HBox spacing="8" alignment="CENTER_LEFT" minWidth="0">
                      <StackPane fx:id="heroWalletIcon"/>
                      <Label text="DOANH THU TRONG TÚI SELLER" minWidth="0" style="-fx-text-fill: #34D399; -fx-font-weight: bold; -fx-font-size: 11.5px;"/>
                      <HBox HBox.hgrow="ALWAYS"/>
                      <Button text="Rút tiền →" minWidth="-Infinity" onAction="#handleOpenSellerWithdraw"
                                                                                                                                                                                                                                                                                                                                                                                              styleClass="sidebar-mini-withdraw" style="-fx-padding: 5 10 5 10; -fx-font-size: 11px;"/>
                    </HBox>
                    <Label fx:id="lblHeroWalletBalance" text="0 đ" styleClass="kpi-value-emerald"/>
                    <Label text="Tiền từ các phiên đấu giá kết thúc có người thắng tự động chuyển thẳng vào ví của bạn."
                                                                                                                                                                                                                                                                                                                                                           wrapText="true" styleClass="text-muted" style="-fx-font-size: 12px;"/>
                  </VBox>
                  <VBox spacing="8" minWidth="128" prefWidth="158" HBox.hgrow="SOMETIMES" styleClass="kpi-card">
                    <Label text="CHỜ DUYỆT" styleClass="kpi-label"/>
                    <Label fx:id="lblKpiPending" text="0" styleClass="kpi-value-amber"/>
                    <Label text="Yêu cầu mở phòng" wrapText="true" styleClass="kpi-sub"/>
                  </VBox>
                  <VBox spacing="8" minWidth="128" prefWidth="158" HBox.hgrow="SOMETIMES" styleClass="kpi-card">
                    <Label text="ĐANG LIVE" styleClass="kpi-label"/>
                    <Label fx:id="lblKpiRunning" text="0" styleClass="kpi-value-cyan"/>
                    <Label text="Phiên đang mở sàn" wrapText="true" styleClass="kpi-sub"/>
                  </VBox>
                  <VBox spacing="8" minWidth="128" prefWidth="158" HBox.hgrow="SOMETIMES" styleClass="kpi-card">
                    <Label text="ĐÃ BÁN XONG" styleClass="kpi-label"/>
                    <Label fx:id="lblKpiSold" text="0" styleClass="kpi-value"/>
                    <Label text="Phiên đã quyết toán" wrapText="true" styleClass="kpi-sub"/>
                  </VBox>
                </HBox>
                <HBox alignment="CENTER_LEFT">
                  <Label text="Các phòng đấu giá &amp; yêu cầu gần đây của bạn" styleClass="section-title"/>
                  <HBox HBox.hgrow="ALWAYS"/>
                  <Button text="Xem tất cả →" onAction="#showMyRoomsTab" styleClass="btn-link-subtle"/>
                </HBox>
                <VBox fx:id="overviewRoomsList" spacing="12" minWidth="0"/>
              </VBox>
            </ScrollPane>
            <!-- TAB 2: SUBMIT AUCTION ROOM REQUEST FORM -->
            <ScrollPane fx:id="tabCreate" fitToWidth="true" hbarPolicy="NEVER" minWidth="0" visible="false" managed="false" styleClass="bidx-scroll">
              <VBox spacing="18" minWidth="0" style="-fx-padding: 20 22 26 22;" maxWidth="1020">
