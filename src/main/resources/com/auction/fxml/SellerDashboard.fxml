                      <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Danh mục (ItemFactory)" styleClass="field-label"/>
                        <ComboBox fx:id="cbCategory" maxWidth="Infinity" styleClass="bidx-combo"/>
                      </VBox>
                      <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Thời lượng phiên đấu giá" styleClass="field-label"/>
                        <ComboBox fx:id="cbDuration" maxWidth="Infinity" styleClass="bidx-combo"/>
                      </VBox>
                    </HBox>
                    <HBox spacing="12">
                      <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Giá khởi điểm (VNĐ) *" styleClass="field-label"/>
                        <TextField fx:id="txtStartPrice" promptText="VD: 15000000" styleClass="bidx-input"/>
                      </VBox>
                      <VBox spacing="5" HBox.hgrow="ALWAYS">
