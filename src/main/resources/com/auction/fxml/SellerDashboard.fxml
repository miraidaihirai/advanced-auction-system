                    <Button fx:id="filterMyPending" text="Chờ duyệt" onAction="#filterMyRoomsPending" styleClass="filter-pill"/>
                    <Button fx:id="filterMyLive" text="Đang LIVE" onAction="#filterMyRoomsLive" styleClass="filter-pill"/>
                    <Button fx:id="filterMySold" text="Đã bán" onAction="#filterMyRoomsSold" styleClass="filter-pill"/>
                    <Button fx:id="filterMyRejected" text="Bị từ chối" onAction="#filterMyRoomsRejected" styleClass="filter-pill"/>
                  </FlowPane>
                </VBox>
                <VBox fx:id="myRoomsContainer" spacing="12" minWidth="0"/>
              </VBox>
            </ScrollPane>
