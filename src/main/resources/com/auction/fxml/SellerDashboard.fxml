<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.ui.SellerDashboardController"
           stylesheets="@../css/bidx-theme.css"
           minWidth="0" minHeight="0"
           styleClass="app-shell">
  <BorderPane minWidth="0" minHeight="0" styleClass="app-shell">
    <!-- Left Seller Studio Sidebar -->
    <left>
      <VBox spacing="14" prefWidth="234" minWidth="206" maxWidth="250" styleClass="sidebar">
        <HBox spacing="11" alignment="CENTER_LEFT" style="-fx-padding: 2 6 8 6;">
          <StackPane fx:id="sidebarLogoWrap" style="-fx-background-color: #0D1322; -fx-background-radius: 12; -fx-border-color: rgba(16,185,129,0.55); -fx-border-radius: 12; -fx-padding: 2;">
            <ImageView fx:id="imgSidebarLogo" fitWidth="38" fitHeight="38" preserveRatio="true"/>
          </StackPane>
          <VBox spacing="1">
            <HBox spacing="0" alignment="BASELINE_LEFT">
              <Label text="Bid" styleClass="sidebar-brand-name"/>
              <Label text="X" styleClass="sidebar-brand-accent"/>
            </HBox>
            <Label text="SELLER STUDIO" styleClass="role-chip-seller"/>
          </VBox>
        </HBox>
        <VBox spacing="6" VBox.vgrow="ALWAYS">
          <Button fx:id="navOverview" text="Tổng quan &amp; Ví tiền" onAction="#showOverviewTab" maxWidth="Infinity" styleClass="nav-btn, nav-btn-active-seller"/>
          <Button fx:id="navCreateRequest" text="Gửi yêu cầu mở phòng" onAction="#showCreateTab" maxWidth="Infinity" styleClass="nav-btn"/>
          <Button fx:id="navMyRooms" text="Phòng đấu giá của tôi" onAction="#showMyRoomsTab" maxWidth="Infinity" styleClass="nav-btn"/>
          <Button fx:id="navPayouts" text="Ví &amp; Nạp / Rút tiền" onAction="#showPayoutsTab" maxWidth="Infinity" styleClass="nav-btn"/>
        </VBox>
        <!-- Seller Pocket Balance Card -->
        <VBox spacing="8" styleClass="sidebar-wallet-card">
          <HBox alignment="CENTER_LEFT" spacing="5">
            <Label text="VÍ SELLER" styleClass="sidebar-wallet-label"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="+ Nạp" minWidth="-Infinity" onAction="#handleOpenSellerDeposit" styleClass="sidebar-mini-deposit"/>
            <Button text="Rút" minWidth="-Infinity" onAction="#handleOpenSellerWithdraw" styleClass="sidebar-mini-withdraw"/>
          </HBox>
          <Label fx:id="lblSidebarWallet" text="0 đ" styleClass="sidebar-wallet-amount-seller"/>
          <Label fx:id="lblSellerIdentity" text="SELLER-01 • Tuấn Đại" styleClass="text-primary" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
          <Label text="● Đối tác đã xác minh" styleClass="text-accent-emerald" style="-fx-font-size: 10.5px; -fx-font-weight: bold;"/>
          <Button fx:id="btnLogout" text="Đăng xuất" onAction="#handleLogout" maxWidth="Infinity" styleClass="btn-ghost" style="-fx-padding: 7 12 7 12; -fx-font-size: 12px;"/>
        </VBox>
      </VBox>
    </left>

    <!-- Main Seller Content -->
    <center>
      <BorderPane minWidth="0" minHeight="0" styleClass="app-shell">
        <top>
          <HBox spacing="12" alignment="CENTER_LEFT" minWidth="0" styleClass="topbar">
            <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS">
              <Label fx:id="lblTopTitle" text="BidX Seller Studio" minWidth="0" styleClass="topbar-title"/>
              <Label text="Gửi yêu cầu mở phòng đấu giá • Doanh thu tự động chảy về túi Seller khi chốt phiên thành công"
                                                                                                                                                                                                                                                     minWidth="0" styleClass="text-subtle" style="-fx-font-size: 12px;"/>
            </VBox>
            <Button fx:id="btnThemeToggle" text="Light" minWidth="-Infinity" onAction="#handleToggleTheme" styleClass="theme-toggle-btn"/>
            <Button fx:id="btnRefresh" onAction="#handleRefresh" styleClass="icon-circle-btn"/>
            <Button fx:id="btnTopNewRequest" text="+ Gửi yêu cầu mở phòng" minWidth="-Infinity" onAction="#showCreateTab" styleClass="btn-emerald"/>
