                                                                                                                                                                                                                                                                                                                                                                                             wrapText="true" styleClass="text-secondary" style="-fx-font-size: 11.5px;"/>
                    </VBox>
                  </VBox>
                </HBox>
              </VBox>
            </ScrollPane>
            <!-- TAB 3: MY AUCTIONS & REQUESTS -->
