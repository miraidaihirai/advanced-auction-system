                  <Label text="Gửi yêu cầu mở phòng đấu giá mới" styleClass="section-title"/>
                  <Label text="Yêu cầu sẽ được gửi trực tiếp đến Hàng đợi kiểm duyệt của Admin. Sau khi Admin bấm Duyệt, phòng sẽ mở LIVE ngay cho Bidder đặt giá."
                                                                                                                                                                                                                                                                                                                         wrapText="true" styleClass="section-sub"/>
                </VBox>
                <HBox spacing="18" minWidth="0">
                  <!-- Left Form Inputs -->
