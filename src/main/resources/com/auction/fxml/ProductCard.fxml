<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="card"
      stylesheets="@../css/bidx-theme.css"
      styleClass="product-card"
      prefWidth="248" minWidth="244" maxWidth="254"
      spacing="9"
      onMouseClicked="#handleCardClick"
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.ui.ProductCardController">
  <!-- Studio Photo + Floating Status & Favorite Heart -->
  <StackPane styleClass="card-img-wrap" prefHeight="142" maxHeight="142">
    <ImageView fx:id="imgProduct" fitWidth="224" fitHeight="142" preserveRatio="false"/>
    <Label fx:id="lblStatusBadge" text="● LIVE" styleClass="badge-live"
                           StackPane.alignment="TOP_LEFT">
      <StackPane.margin>
        <Insets top="8" left="8"/>
      </StackPane.margin>
    </Label>
    <Button fx:id="btnFavorite" onAction="#handleToggleFavorite" styleClass="card-fav-btn"
                            StackPane.alignment="TOP_RIGHT">
      <StackPane.margin>
        <Insets top="8" right="8"/>
      </StackPane.margin>
    </Button>
  </StackPane>
  <!-- Title & Category -->
  <VBox spacing="3">
    <HBox alignment="CENTER_LEFT" spacing="6">
      <Label fx:id="lblCategory" text="Đồng hồ cổ" styleClass="card-category"/>
      <Label text="•" style="-fx-text-fill: #475569; -fx-font-size: 10px;"/>
      <Label fx:id="lblId" text="AUC-001" style="-fx-text-fill: #64748B; -fx-font-size: 10.5px; -fx-font-weight: bold;"/>
    </HBox>
    <Label fx:id="lblName" text="Đồng Hồ Cơ Thụy Sĩ Vintage Gold" styleClass="card-title"
                           wrapText="true" minHeight="38" maxHeight="40"/>
  </VBox>
  <!-- Price -->
  <VBox spacing="1">
    <Label text="Giá hiện tại" styleClass="card-price-caption"/>
    <Label fx:id="lblPrice" text="19,500,000 đ" styleClass="card-price"/>
  </VBox>
  <!-- Countdown & Bid Count -->
  <HBox alignment="CENTER_LEFT" spacing="8">
    <Label fx:id="lblTime" text="00h 44m 18s" styleClass="card-timer"/>
    <HBox HBox.hgrow="ALWAYS"/>
    <Label fx:id="lblBids" text="0 Bids" styleClass="card-bids"/>
  </HBox>
  <!-- Primary CTA Button -->
  <Button fx:id="btnBid" text="ĐẶT GIÁ" onAction="#handleOpenRoom"
                  maxWidth="Infinity" styleClass="btn-card-bid"/>
</VBox>
