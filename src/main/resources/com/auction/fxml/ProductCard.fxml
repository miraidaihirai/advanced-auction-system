<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="card" stylesheets="@../css/styleCard.css" styleClass="productCard"
    xmlns="http://javafx.com/javafx/21" 
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.auction.ui.ProductCardController">
    <children>
        <!--Hình ảnh-->
        
        <!--Thông tin sản phẩm-->
        <VBox spacing="4" styleClass="inforProduct">
            <Label fx:id="lblId" styleClass="product-id"/>
            <Label fx:id="lblName" styleClass="product-name"/>
            <Label fx:id="lblPrice" styleClass="product-price"/>
            
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="lblTime" styleClass="time-label" text="03h 10m 10s"/>
                <Label fx:id="lblBids" styleClass="bids-label" text="5 Bids" />
            </HBox>
            <!--Nút đặt giá-->
            <Button fx:id="btnBid" styleClass="bid-button" text="ĐẶT GIÁ" maxWidth="Infinity" />
        </VBox>
    </children>
</VBox>