<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox stylesheets="@../css/styleCard.css" styleClass="productCard"
      prefWidth="280" maxWidth="300" spacing="10"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.ui.RequestCardController">
    <children>
        <!-- Header: Category & Status -->
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="card-top-banner">
            <Label fx:id="lblCategory" text="Danh mục: Nghệ thuật" styleClass="card-category-pill"/>
            <HBox HBox.hgrow="ALWAYS" />
            <Label fx:id="lblStatus" text="Trạng thái: Chờ duyệt" style="-fx-text-fill: #F59E0B; -fx-font-size: 11px; -fx-font-weight: bold;"/>
        </HBox>

        <!-- Product Name & Info -->
        <VBox spacing="6">
            <Label fx:id="lblProductName" text="Tên sản phẩm yêu cầu" styleClass="product-name" wrapText="true" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"/>
            <Label fx:id="lblStartPrice" text="Giá khởi điểm: 10,000,000 đ" style="-fx-text-fill: #F59E0B; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            <Label fx:id="lblStepPrice" text="Bước giá: 500,000 đ" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;"/>
            <Label fx:id="lblCreator" text="Người gửi: SELLER-01" style="-fx-text-fill: #38BDF8; -fx-font-size: 11px;"/>
            <Label fx:id="lblCreatedAt" text="Gửi lúc: 12:00 20/11/2026" style="-fx-text-fill: #64748B; -fx-font-size: 10px;"/>
            <Label fx:id="lblDescription" text="Mô tả thông số chi tiết..." wrapText="true" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px; -fx-padding: 4 0 0 0;"/>
        </VBox>

        <!-- 2 Action Buttons: Xác nhận & Hủy -->
        <HBox fx:id="actionRow" spacing="8" alignment="CENTER" style="-fx-padding: 8 0 0 0;">
            <Button fx:id="btnApprove" text="Xác nhận" onAction="#handleApprove" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                    style="-fx-background-color: #10B981; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-padding: 8 0; -fx-background-radius: 6; -fx-cursor: hand;"/>
            <Button fx:id="btnCancel" text="Hủy" onAction="#handleCancel" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                    style="-fx-background-color: #EF4444; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-padding: 8 0; -fx-background-radius: 6; -fx-cursor: hand;"/>
        </HBox>
    </children>
</VBox>
