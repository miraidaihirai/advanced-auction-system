<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<!-- VBox gốc căn giữa, gắn styleClass nền và đường dẫn file CSS -->

<VBox alignment="CENTER" stylesheets="@../css/styleProductDetails.css" 
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.ui.ProductDetailsController">
  <!-- Khung Card trắng bo tròn chứa nội dung chi tiết -->
  <VBox alignment="TOP_LEFT" spacing="15" styleClass="details-card" maxWidth="450">
    <!-- Tiêu đề -->
    <Label styleClass="title-label" text="Chi Tiết Sản Phẩm"/>

    <!-- Ảnh sản phẩm -->
    <StackPane alignment="CENTER" prefHeight="130" maxHeight="140" styleClass="details-image-frame">
      <ImageView fx:id="imgDetails" fitWidth="390" fitHeight="130" preserveRatio="false"/>
    </StackPane>
    <!-- Nhóm thông tin: Tên sản phẩm -->
    <VBox fx:id="boxProductName" spacing="3">
      <Label styleClass="field-label" text="Tên sản phẩm"/>
      <Label fx:id="lblProductName" styleClass="value-label" text="-- Chưa có dữ liệu --"/>
    </VBox>
    <!-- Nhóm thông tin: Giá khởi điểm -->
    <VBox fx:id="boxStartPrice" spacing="3">
      <Label styleClass="field-label" text="Giá khởi điểm"/>
      <Label fx:id="lblStartPrice" styleClass="value-label" text="-- Chưa có dữ liệu --"/>
    </VBox>
    <!-- Nhóm thông tin: ID sản phẩm -->
    <VBox fx:id="boxId" spacing="3">
      <Label styleClass="field-label" text="ID sản phẩm"/>
      <Label fx:id="lblId" styleClass="value-label" text="-- Chưa có dữ liệu --"/>
    </VBox>
    <!-- Nhóm thông tin: SỐ lượng -->
    <VBox fx:id="boxQuantity" spacing="3">
      <Label styleClass="field-label" text="Số lượng sản phẩm"/>
      <Label fx:id="lblQuantity" styleClass="value-label" text="-- Chưa có dữ liệu --"/>
    </VBox>
    <!--Nhóm thông tin: Tên người sáng tác -->
    <VBox fx:id="boxArtist" spacing="3">
      <Label styleClass="field-label" text="Tên người sáng tác"/>
      <Label fx:id="lblArtist" styleClass="value-label" text="-- Chưa có dữ liệu --"/>
    </VBox>
    <!--Nhóm thông tin: Chất liệu sản phẩm-->
    <VBox fx:id="boxMedium" spacing="3">
      <Label styleClass="field-label" text="Chất liệu sản phẩm"/>
      <Label fx:id="lblMedium" styleClass="value-label" text="-- Chưa có dữ liệu --"/>
    </VBox>
    <VBox fx:id="boxYearCreated" spacing="3">
      <Label styleClass="field-label" text="Năm sáng tác"/>
      <Label fx:id="lblYearCreated" styleClass="value-label" text="-- Chưa có dữ liệu --"/>
    </VBox>
    <VBox fx:id="boxBrand" spacing="3">
      <Label styleClass="field-label" text="Hãng sản phẩm"/>
      <Label fx:id="lblBrand" styleClass="value-label" text="-- Chưa có dữ liệu --"/>
    </VBox>
    <VBox fx:id="boxModel" spacing="3">
      <Label styleClass="field-label" text="Mẫu sản phẩm"/>
      <Label fx:id="lblModel" styleClass="value-label" text="-- Chưa có dữ liệu --"/>
    </VBox>
    <VBox fx:id="boxWarrantyPeriod" spacing="3">
      <Label styleClass="field-label" text="Thời hạn bảo hành"/>
      <Label fx:id="lblWarrantyPeriod" styleClass="value-label" text="-- Chưa có dữ liệu --"/>
    </VBox>
    <VBox fx:id="boxYear" spacing="3">
      <Label styleClass="field-label" text="Năm sản xuất"/>
      <Label fx:id="lblYear" styleClass="value-label" text="-- Chưa có dữ liệu --"/>
    </VBox>
    <!-- Khu vực nút bấm điều hướng -->
    <HBox alignment="CENTER_RIGHT" spacing="12" style="-fx-padding: 15 0 0 0;">
      <Button text="Quay lại" onAction="#handleBack" styleClass="back-button"/>
    </HBox>
  </VBox>
</VBox>
