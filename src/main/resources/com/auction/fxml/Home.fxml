<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.UI.HomeController">
  <children>
    <Label fx:id="eventLabel" text="Waiting for auction update... "/>
    <Button fx:id="Back" text="Back" onAction="#SwitchToLogin"/>
    <Button
      text="Enter Auction Room"
      onAction="#SwitchToAuction"/>
  </children>
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
  </padding>
</VBox>
