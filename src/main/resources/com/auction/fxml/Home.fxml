<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.ui.HomeController">
  <BorderPane styleClass="home-pane" stylesheets="@../css/styleHome.css">
    <!--Thanh công cụ-->
    <top>
      <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 15px; -fx-background-color: #161922;">
        <!-- Thanh tìm kiếm theo tên hoặc ID sản phẩm -->
        <TextField fx:id="searchField" promptText="Tìm kiếm theo tên hoặc ID sản phẩm..."
                                   HBox.hgrow="ALWAYS" styleClass="search-field" />
        <!-- Nút tạo phòng đấu giá sản phẩm -->
        <Button fx:id="btnCreateAuctionRoom" text="Tạo phòng đấu giá"
                                styleClass="create-button" onAction="#handleCreateAuctionRoom" />
      </HBox>
    </top>

    <!--Phần trung tâm màn hình-->
    <center>
      <ScrollPane fitToWidth="true" styleClass="edge-to-edge" style="-fx-background: #0f1115; -fx-background-color: #0f1115;">
        <content>
          <!--Bố cục hiển thị danh sách sản phẩm-->
          <FlowPane fx:id="productGridContainer" hgap="20" vgap="20" style="-fx-padding: 20px;">
          </FlowPane>
        </content>
      </ScrollPane>
    </center>
  </BorderPane>
  <!-- Lớp phủ (Overlay) nằm bên trong StackPane, chồng lên BorderPane -->
  <StackPane fx:id="overlayPane" visible="false" managed="false" style="-fx-background-color: rgba(0, 0, 0, 0.7);" alignment="CENTER">
    <!-- Nhúng file FXML con vào đây -->
    <fx:include fx:id="createRoomSubView" source="CreateAuctionRoom.fxml"/>
  </StackPane>
</StackPane>
