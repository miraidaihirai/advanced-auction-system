<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="registerRoot"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.ui.RegisterController"
           stylesheets="@../css/bidx-theme.css"
           minWidth="0" minHeight="0"
           styleClass="auth-root">

    <Pane fx:id="ambientPane" mouseTransparent="true"/>

    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" minWidth="0" minHeight="0" styleClass="bidx-scroll">
        <StackPane alignment="CENTER" minWidth="0" minHeight="0">
            <HBox alignment="CENTER" spacing="30" maxWidth="1120" minWidth="0" style="-fx-padding: 16 28 16 28;">

                <!-- Left 60 FPS Motion-Graphics Promo Showcase -->
                <StackPane fx:id="promoHost" prefWidth="490" prefHeight="555" minWidth="350" minHeight="420" maxWidth="540" maxHeight="610" HBox.hgrow="SOMETIMES"/>

                <!-- Right Upgraded Glassmorphism Register Card -->
                <VBox fx:id="registerCard" spacing="11" prefWidth="454" minWidth="390" maxWidth="472" styleClass="auth-card" style="-fx-padding: 22 28 20 28;">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <StackPane fx:id="logoWrap" style="-fx-background-color: #0D1322; -fx-background-radius: 14; -fx-border-color: rgba(255,158,68,0.55); -fx-border-radius: 14; -fx-padding: 3;">
                    <ImageView fx:id="imgLogo" fitWidth="46" fitHeight="46" preserveRatio="true"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="Gia nhập BidX" styleClass="auth-card-title"/>
                    <Label text="Khởi tạo tài khoản &amp; trải nghiệm đấu giá đỉnh cao" styleClass="auth-card-sub"/>
                </VBox>
            </HBox>

            <!-- Interactive Neon Role Selector Cards -->
            <VBox spacing="8">
                <Label text="Bạn muốn tham gia với tư cách" styleClass="field-label"/>
                <HBox spacing="12">
                    <VBox fx:id="roleBidderCard" spacing="6" HBox.hgrow="ALWAYS" onMouseClicked="#selectBidderRole"
                          styleClass="role-choice-card, role-choice-selected">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <StackPane fx:id="iconBidder" minWidth="30" minHeight="30"
                                       style="-fx-background-color: rgba(255,123,36,0.20); -fx-background-radius: 9;"/>
                            <Label text="BIDDER" styleClass="text-accent-orange" style="-fx-font-weight: bold; -fx-font-size: 13.5px;"/>
                        </HBox>
                        <Label text="Săn vật phẩm độc bản" wrapText="true" styleClass="text-primary" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <Label text="Tặng ngay ví 500M đ trải nghiệm" styleClass="text-accent-gold" style="-fx-font-size: 10.5px;"/>
                    </VBox>

                    <VBox fx:id="roleSellerCard" spacing="6" HBox.hgrow="ALWAYS" onMouseClicked="#selectSellerRole"
                          styleClass="role-choice-card">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <StackPane fx:id="iconSeller" minWidth="30" minHeight="30"
                                       style="-fx-background-color: rgba(16,185,129,0.20); -fx-background-radius: 9;"/>
                            <Label text="SELLER" styleClass="text-accent-emerald" style="-fx-font-weight: bold; -fx-font-size: 13.5px;"/>
                        </HBox>
                        <Label text="Mở phòng đấu giá bán" wrapText="true" styleClass="text-primary" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <Label text="Nhận doanh thu tự động về ví" styleClass="text-accent-emerald" style="-fx-font-size: 10.5px;"/>
                    </VBox>
                </HBox>
            </VBox>

            <HBox spacing="12">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="Mã tài khoản" styleClass="field-label"/>
                        <Label fx:id="lblIdValid" text="" style="-fx-text-fill: #34D399; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    </HBox>
                    <TextField fx:id="txtUserId" promptText="VD: BIDDER-99" styleClass="bidx-input"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="Tên hiển thị" styleClass="field-label"/>
                        <Label fx:id="lblNameValid" text="" style="-fx-text-fill: #34D399; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    </HBox>
                    <TextField fx:id="txtDisplayName" promptText="VD: Tuấn_Đại" styleClass="bidx-input"/>
                </VBox>
            </HBox>

            <VBox spacing="6">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Mật khẩu bảo mật (tối thiểu 8 ký tự)" styleClass="field-label"/>
                    <HBox HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblPwdStrength" text="" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                </HBox>
                <PasswordField fx:id="txtPassword" promptText="Nhập mật khẩu bảo mật..." styleClass="bidx-input" onAction="#Register"/>
                <ProgressBar fx:id="pwdStrengthBar" progress="0.0" maxWidth="Infinity" prefHeight="5"
                             style="-fx-accent: #FF7B24; -fx-control-inner-background: #1C2640;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Xác nhận mật khẩu" styleClass="field-label"/>
                <PasswordField fx:id="txtConfirmPassword" promptText="Nhập lại mật khẩu..." styleClass="bidx-input" onAction="#Register"/>
            </VBox>

            <Label fx:id="errorRegister" text="" wrapText="true" style="-fx-text-fill: #FB7185; -fx-font-size: 12.5px; -fx-font-weight: bold;"/>

            <Button fx:id="btnRegister" text="KHỞI TẠO TÀI KHOẢN BIDX" onAction="#Register" maxWidth="Infinity" styleClass="btn-fire"/>

            <HBox alignment="CENTER" spacing="6">
                <Label text="Đã có tài khoản BidX?" style="-fx-text-fill: #94A3B8; -fx-font-size: 12.5px;"/>
                <Button text="← Quay lại Đăng nhập" onAction="#backToLogin" styleClass="btn-link-subtle"/>
            </HBox>
                </VBox>

            </HBox>
        </StackPane>
    </ScrollPane>

    <!-- Floating Light/Dark Theme Switcher (Always clickable above ScrollPane) -->
    <Button fx:id="btnThemeToggle" text="Light" onAction="#handleToggleTheme"
            styleClass="theme-toggle-btn" StackPane.alignment="TOP_RIGHT">
        <StackPane.margin>
            <Insets top="16" right="22"/>
        </StackPane.margin>
    </Button>
</StackPane>
