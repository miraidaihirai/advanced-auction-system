<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--Khung cho toàn bộ giao diện, Làm khung chứa toàn cục (Root Container) và định vị các thành phần con dựa trên khoảng cách neo (anchors) đối với các mép của cửa sổ ứng dụng.-->
<AnchorPane fx:id="RegisterPane"
            prefHeight="600.0" prefWidth="800.0"
            stylesheets="@../css/styleLogIn.css"
            styleClass="Login-pane"
            xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.ui.RegisterController">
    <children>
        <!--Thẻ ngoài bao quát-->
        <VBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <!--khung giao diện chứa nội dung-->
                <VBox alignment="CENTER_LEFT" prefWidth="400.0" maxWidth="400.0" spacing="18.0" styleClass="login-card">
                    <padding>
                        <!-- căn chỉnh toàn bộ text, field, button bên trong vào giữa-->
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
                    </padding>
                    <children>
                        <!--Phần tiêu đề-->
                        <VBox spacing="6.0">
                            <children>
                                <Label styleClass="title-label" text="Register"/>
                            </children>
                            <VBox.margin>
                                <Insets bottom="10.0"/>
                            </VBox.margin>
                        </VBox>
                        <!--Phần ô nhập tài khoản-->
                        <VBox spacing="6.0">
                            <children>
                                <Label styleClass="sub-label" text="Username"/>
                                <TextField fx:id="username" promptText="Enter username..."/>
                            </children>
                        </VBox>
                        <!--Ô nhập password-->
                        <VBox spacing="6.0">
                            <children>
                                <Label styleClass="sub-label" text="Password"/>
                                <PasswordField fx:id="password" promptText="Enter password...">
                                    <VBox.margin>
                                        <Insets bottom="10.0"/>
                                    </VBox.margin>
                                </PasswordField>
                            </children>
                        </VBox>
                        <Label fx:id="errorRegister" styleClass="error-label" textFill="#e74c3c" />
                        <Button fx:id="RegisterButton" maxWidth="Infinity" styleClass="button" text="Submit" onAction="#Register"/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>