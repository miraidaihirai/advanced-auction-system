<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.ui.AuctionRequestListController"
           stylesheets="@../css/styleHome.css">
    <BorderPane styleClass="home-main-layout">
        <!-- Top Navigation -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="18" styleClass="top-nav-bar" style="-fx-padding: 16 24;">
                <Button text="&lt; Quay lại Trang chủ" onAction="#handleBackToHome" styleClass="btn-refresh-list" style="-fx-cursor: hand;"/>
                <VBox spacing="2">
                    <Label fx:id="lblSectionTitle" text="DANH SÁCH YÊU CẦU ĐẤU GIÁ SẢN PHẨM" styleClass="section-header-title" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #EA580C;"/>
                    <Label text="Các yêu cầu tạo phiên đấu giá đang chờ xét duyệt trong hệ thống" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                </VBox>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button text="Làm mới" onAction="#refreshList" styleClass="btn-refresh-list" style="-fx-cursor: hand;"/>
            </HBox>
        </top>

        <!-- Center: FlowPane of Request Cards -->
        <center>
            <ScrollPane fitToWidth="true" styleClass="grid-scroll-pane">
                <content>
                    <VBox spacing="18" styleClass="grid-wrapper" style="-fx-padding: 24;">
                        <Label fx:id="lblEmptyHint" text="Hiện không có yêu cầu đấu giá nào đang chờ duyệt." visible="false" managed="false"
                               style="-fx-font-size: 14px; -fx-text-fill: #9CA3AF; -fx-font-style: italic;"/>
                        <FlowPane fx:id="requestCardContainer" hgap="20" vgap="20" styleClass="product-grid-flow">
                            <!-- Thẻ yêu cầu đấu giá nạp động tại đây -->
                        </FlowPane>
                    </VBox>
                </content>
            </ScrollPane>
        </center>
    </BorderPane>
</StackPane>
