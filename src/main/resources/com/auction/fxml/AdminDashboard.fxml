<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.ui.AdminDashboardController"
           stylesheets="@../css/bidx-theme.css"
           styleClass="app-shell">

    <BorderPane styleClass="app-shell">

        <!-- Left Admin Control Sidebar -->
        <left>
            <VBox spacing="14" prefWidth="254" minWidth="242" maxWidth="264" styleClass="sidebar">
                <HBox spacing="11" alignment="CENTER_LEFT" style="-fx-padding: 2 6 8 6;">
                    <StackPane fx:id="sidebarLogoWrap" style="-fx-background-color: #0D1322; -fx-background-radius: 12; -fx-border-color: rgba(56,189,248,0.55); -fx-border-radius: 12; -fx-padding: 2;">
                        <ImageView fx:id="imgSidebarLogo" fitWidth="38" fitHeight="38" preserveRatio="true"/>
                    </StackPane>
                    <VBox spacing="1">
                        <HBox spacing="0" alignment="BASELINE_LEFT">
                            <Label text="Bid" styleClass="sidebar-brand-name"/>
                            <Label text="X" styleClass="sidebar-brand-accent"/>
                        </HBox>
                        <Label text="ADMIN CONTROL" styleClass="role-chip-admin"/>
                    </VBox>
                </HBox>

                <VBox spacing="6" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Button fx:id="navQueue" text="Duyệt yêu cầu" onAction="#showQueueTab" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="nav-btn, nav-btn-active-admin"/>
                        <Label fx:id="lblPendingNavBadge" text="0" styleClass="badge-pending"/>
                    </HBox>
                    <Button fx:id="navMonitor" text="Giám sát toàn sàn" onAction="#showMonitorTab" maxWidth="Infinity" styleClass="nav-btn"/>
                    <Button fx:id="navUsers" text="Người dùng &amp; Ví tiền" onAction="#showUsersTab" maxWidth="Infinity" styleClass="nav-btn"/>
                    <Button fx:id="navMoneyFlow" text="Dòng tiền hệ thống" onAction="#showMoneyFlowTab" maxWidth="Infinity" styleClass="nav-btn"/>
                </VBox>

                <!-- Admin Identity Card -->
                <VBox spacing="8" styleClass="sidebar-wallet-card">
                    <Label text="QUẢN TRỊ VIÊN HỆ THỐNG" styleClass="sidebar-wallet-label"/>
                    <Label fx:id="lblAdminIdentity" text="ADMIN-01 • BidX Admin" style="-fx-text-fill: #38BDF8; -fx-font-size: 13.5px; -fx-font-weight: bold;"/>
                    <Label text="● Hệ thống hoạt động ổn định" style="-fx-text-fill: #34D399; -fx-font-size: 10.5px; -fx-font-weight: bold;"/>
                    <Button fx:id="btnLogout" text="Đăng xuất" onAction="#handleLogout" maxWidth="Infinity" styleClass="btn-ghost" style="-fx-padding: 7 12 7 12; -fx-font-size: 12px;"/>
                </VBox>
            </VBox>
        </left>

        <!-- Main Admin Workspace -->
        <center>
            <BorderPane styleClass="app-shell">
                <top>
                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="topbar">
                        <VBox spacing="2">
                            <Label fx:id="lblTopTitle" text="BidX Admin Command Center" styleClass="topbar-title"/>
                            <Label text="Kiểm duyệt yêu cầu mở phòng của Seller • Giám sát phiên LIVE &amp; dòng tiền quyết toán"
                                   styleClass="text-subtle" style="-fx-font-size: 12px;"/>
                        </VBox>
                        <HBox HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnThemeToggle" text="Light" onAction="#handleToggleTheme" styleClass="theme-toggle-btn"/>
                        <Label text="● QUYỀN ADMIN" styleClass="role-chip-admin"/>
                        <Button fx:id="btnRefresh" onAction="#handleRefresh" styleClass="icon-circle-btn"/>
                    </HBox>
                </top>

                <center>
                    <VBox spacing="0">
                        <!-- Top KPI Strip (Always Visible on Admin Dashboard) -->
                        <HBox spacing="16" style="-fx-padding: 18 26 6 26;">
                            <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="kpi-card">
                                <Label text="YÊU CẦU CHỜ DUYỆT" styleClass="kpi-label"/>
                                <Label fx:id="lblKpiPending" text="0" styleClass="kpi-value-amber"/>
                                <Label text="Từ các Seller đang chờ lên sàn" styleClass="kpi-sub"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="kpi-card">
                                <Label text="PHIÊN ĐANG LIVE" styleClass="kpi-label"/>
                                <Label fx:id="lblKpiLive" text="0" styleClass="kpi-value-emerald"/>
                                <Label text="Đang mở cho Bidder đặt giá" styleClass="kpi-sub"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="kpi-card-highlight-cyan">
                                <Label text="DOANH THU ĐÃ CHẢY VỀ SELLER" styleClass="kpi-label"/>
                                <Label fx:id="lblKpiSellerPayout" text="0 đ" styleClass="kpi-value-cyan"/>
                                <Label text="Tổng giá trị quyết toán thành công" styleClass="kpi-sub"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="kpi-card">
                                <Label text="TỔNG TÀI KHOẢN" styleClass="kpi-label"/>
                                <Label fx:id="lblKpiUsers" text="0" styleClass="kpi-value"/>
                                <Label fx:id="lblKpiUsersSub" text="Bidder • Seller • Admin" styleClass="kpi-sub"/>
                            </VBox>
                        </HBox>

                        <StackPane VBox.vgrow="ALWAYS">

                            <!-- TAB 1: APPROVAL QUEUE -->
                            <ScrollPane fx:id="tabQueue" fitToWidth="true" styleClass="bidx-scroll">
                                <VBox spacing="14" style="-fx-padding: 16 26 28 26;">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Hàng đợi yêu cầu mở phòng đấu giá từ Seller" styleClass="section-title"/>
                                        <HBox HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="lblQueueSummary" text="0 yêu cầu chờ duyệt" styleClass="badge-pending"/>
                                    </HBox>
                                    <VBox fx:id="approvalQueueContainer" spacing="14"/>
                                </VBox>
                            </ScrollPane>

                            <!-- TAB 2: ALL AUCTIONS MONITOR -->
                            <ScrollPane fx:id="tabMonitor" fitToWidth="true" visible="false" managed="false" styleClass="bidx-scroll">
                                <VBox spacing="14" style="-fx-padding: 16 26 28 26;">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="Giám sát toàn bộ phiên đấu giá trên sàn" styleClass="section-title"/>
                                        <HBox HBox.hgrow="ALWAYS"/>
                                        <Button fx:id="monAll" text="Tất cả" onAction="#filterMonAll" styleClass="filter-pill, filter-pill-active"/>
                                        <Button fx:id="monLive" text="Đang LIVE" onAction="#filterMonLive" styleClass="filter-pill"/>
                                        <Button fx:id="monFinished" text="Đã kết thúc / Đã trả tiền" onAction="#filterMonEnded" styleClass="filter-pill"/>
                                        <Button fx:id="monRejected" text="Đã từ chối" onAction="#filterMonRejected" styleClass="filter-pill"/>
                                    </HBox>
                                    <VBox fx:id="monitorListContainer" spacing="12"/>
                                </VBox>
                            </ScrollPane>

                            <!-- TAB 3: USERS & LIVE WALLETS -->
                            <ScrollPane fx:id="tabUsers" fitToWidth="true" visible="false" managed="false" styleClass="bidx-scroll">
                                <VBox spacing="14" style="-fx-padding: 16 26 28 26;">
                                    <VBox spacing="3">
                                        <Label text="Danh sách người dùng &amp; Số dư ví trực tuyến" styleClass="section-title"/>
                                        <Label text="Theo dõi trực tiếp số dư ví của từng Bidder và tổng tiền đã chảy vào túi từng Seller." styleClass="section-sub"/>
                                    </VBox>
                                    <VBox fx:id="usersListContainer" spacing="10"/>
                                </VBox>
                            </ScrollPane>

                            <!-- TAB 4: PLATFORM MONEY FLOW -->
                            <ScrollPane fx:id="tabMoneyFlow" fitToWidth="true" visible="false" managed="false" styleClass="bidx-scroll">
                                <VBox spacing="14" style="-fx-padding: 16 26 28 26;">
                                    <VBox spacing="3">
                                        <Label text="Nhật ký dòng tiền toàn hệ thống BidX" styleClass="section-title"/>
                                        <Label text="Ghi nhận tự động mỗi khi phiên kết thúc thành công và tiền chuyển từ Bidder sang ví Seller." styleClass="section-sub"/>
                                    </VBox>
                                    <VBox fx:id="moneyFlowContainer" spacing="10"/>
                                </VBox>
                            </ScrollPane>

                        </StackPane>
                    </VBox>
                </center>
            </BorderPane>
        </center>

    </BorderPane>

    <!-- Reject Reason Modal Overlay -->
    <StackPane fx:id="rejectModal" visible="false" managed="false" styleClass="modal-backdrop" alignment="CENTER">
        <VBox spacing="14" maxWidth="460" prefWidth="440" styleClass="modal-card">
            <Label text="Từ chối yêu cầu mở phòng đấu giá" styleClass="text-primary" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label fx:id="lblRejectTarget" text="Phiên: AUC-008" style="-fx-text-fill: #FB7185; -fx-font-weight: bold; -fx-font-size: 13px;"/>
            <VBox spacing="6">
                <Label text="Lý do từ chối (gửi trực tiếp đến Seller):" styleClass="field-label"/>
                <TextArea fx:id="txtRejectReason" prefRowCount="3" wrapText="true"
                          promptText="VD: Thiếu giấy kiểm định chính hãng hoặc giá khởi điểm chưa phù hợp..."
                          styleClass="bidx-textarea"/>
            </VBox>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Hủy" onAction="#handleCancelReject" styleClass="btn-ghost"/>
                <Button text="Xác nhận từ chối" onAction="#handleConfirmReject" styleClass="btn-crimson-outline"/>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>
